{
  "name": "doctor-tracker-server",
  "version": "1.0.0",
  "description": "Doctor Tracker REST API Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --project tsconfig.test.json --noEmit",
    "seed": "tsx scripts/seed.ts",
    "test": "npx tsx tests/testAuthEndpoints.ts && npx tsx tests/testDoctorEndpoints.ts && npx tsx tests/testPatientEndpoints.ts && npx tsx tests/testDashboardEndpoints.ts",
    "test:integration": "tsx tests/testLiveIntegration.ts",
    "test:browser": "tsx tests/runBrowserAudit.ts"
  },
  "keywords": [
    "doctor-tracker",
    "express",
    "mongodb",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
