# Server Runtime Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local instance or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker

# JWT Authentication (Use a high-entropy secret in production)
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
JWT_EXPIRES_IN=7d

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:3000

# Seed Admin Credentials (Optional configuration for running npm run seed)
SEED_ADMIN_EMAIL=admin@doctortracker.com
SEED_ADMIN_PASSWORD=password123
